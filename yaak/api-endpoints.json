{
  "info": {
    "name": "API Monitoring & Auth System",
    "description": "Production-grade Role-Based Auth API with Redis caching, session management, account lockout protection, and user management. Run \"Login\" first: Yaak's cookie jar keeps the session for every other request. Set the userId variable to target a user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "healthUrl",
      "value": "http://localhost:3001/health"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{healthUrl}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "health"
          ]
        },
        "description": "System & service health check reporting uptime, database connectivity, and Redis latency metrics."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Sets the session cookie in Yaak's cookie jar. Also returns `token` for `Authorization: Bearer <token>`. Rate-limited and shielded by Redis account lockout (5 failed attempts locks account for 15 min).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rimux0x\",\n  \"password\": \"Asdxz12@#\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Log in as manager account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager.one\",\n  \"password\": \"Manager1@pass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns current user details, role, permissions, and active session info."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            },
            "description": "Updates current user profile (name, image, etc.).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administrator Updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Changes user password. Revokes all other active sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Asdxz12@#\",\n  \"newPassword\": \"NewAsdxz12@#\",\n  \"revokeOtherSessions\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Terminates the session and blacklists the token in Redis."
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Active Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sessions"
              ]
            },
            "description": "List all active sessions for current user with IP, User-Agent, and current session flag."
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Revoke a specific session ID and blacklist its token in Redis."
          }
        },
        {
          "name": "Revoke All Other Sessions",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/revoke-others",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sessions",
                "revoke-others"
              ]
            },
            "description": "Revoke every active session except the current one."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Admin only. Creates a manager user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manager One\",\n  \"username\": \"manager.one\",\n  \"email\": \"manager.one@example.com\",\n  \"password\": \"Manager1@pass\",\n  \"role\": \"manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Admin only. Creates a second admin user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second Admin\",\n  \"username\": \"admin.two\",\n  \"email\": \"admin.two@example.com\",\n  \"password\": \"Admin2@pass!\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Admins see everyone. Managers only see managers. Optional: role=admin|manager, search=<text>."
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Retrieve user by ID."
          }
        },
        {
          "name": "Change role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "role"
              ]
            },
            "description": "Admin only. You cannot change your own role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ban user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/ban",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "ban"
              ]
            },
            "description": "Admin only. Omit expiresInDays for a permanent ban. Signs the user out everywhere.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Policy violation\",\n  \"expiresInDays\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unban user",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/unban",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "unban"
              ]
            },
            "description": "Admin only."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Admin only. You cannot delete yourself."
          }
        }
      ]
    }
  ]
}
