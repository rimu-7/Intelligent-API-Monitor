{
  "name": "@apimon/telemetry-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic healthcare API telemetry generator and push client.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
