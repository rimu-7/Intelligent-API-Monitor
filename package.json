{
  "name": "intelligent-api-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent API monitoring & alert system — telemetry ingestion, deterministic anomaly detection, LLM-enriched alerts.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis",
    "dev": "concurrently -k -n api,worker,sim -c blue,magenta,green \"npm run dev:server -w @apimon/monitor-api\" \"npm run dev:worker -w @apimon/monitor-api\" \"npm run dev -w @apimon/telemetry-simulator\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:contract": "npm run test:contract --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "db:generate": "npm run db:generate -w @apimon/monitor-api",
    "db:migrate": "npm run db:migrate -w @apimon/monitor-api",
    "smoke": "node --env-file=.env scripts/smoke-test.mjs",
    "ingest:file": "node --env-file=.env scripts/ingest-file.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
